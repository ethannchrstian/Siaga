# Keep the build context small and the image free of things it must not ship.
**/node_modules
**/dist
**/venv
**/.venv-prod
**/__pycache__
**/*.pyc
**/.pytest_cache

# Training tables and the ml/ pipeline are not needed to serve. Predictions are
# precomputed into data/risk_history.parquet.
backend/data/flood_dataset.parquet
backend/data/drought_dataset.parquet
backend/ml
backend/tests
data-raw

.git
.gitignore
*.md
